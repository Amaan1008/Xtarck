{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "none",
    "moduleDetection": "legacy",

    "noImplicitAny": false,
    "strictNullChecks": false,
    "strict": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "newLine": "lf",
    "rootDir": "ts",
    "outDir": "./js"
  }
}
